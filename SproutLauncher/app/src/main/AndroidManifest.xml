<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <package android:name="com.google.android.youtube" />
        <package android:name="com.android.vending" />
        <package android:name="com.discord" />
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.photos" />
    </queries>

    <application
        android:name=".LauncherApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SproutLauncher">
        <activity
            android:name=".SteamGridDBActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.SproutLauncher"
            tools:ignore="DiscouragedApi" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.SproutLauncher"
            android:windowLayoutInDisplayCutoutMode="shortEdges"
            tools:ignore="DiscouragedApi"
            tools:targetApi="o_mr1">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ExtendedActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.SproutLauncher"
            tools:ignore="DiscouragedApi" />
        <activity
            android:name=".AppTileSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.SproutLauncher"
            tools:ignore="DiscouragedApi" />
        <activity
            android:name=".ShortcutHandlerActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:priority="999">
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".LegacyShortcutReceiver"
            android:exported="true"
            android:permission="com.android.launcher.permission.INSTALL_SHORTCUT">
            <intent-filter>
                <action android:name="com.android.launcher.action.INSTALL_SHORTCUT" />
            </intent-filter>
        </receiver>
    </application>

</manifest>